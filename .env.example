# Environment Configuration Template
# Copy this to .env and fill in your values

# OpenAI API Configuration
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.1

# Application Settings
APP_NAME=Shariah Compliance Copilot
APP_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis Cache (optional, falls back to in-memory if not available)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL=3600

# File Storage
UPLOAD_DIR=data/uploads
REPORT_DIR=data/reports
CONTRACT_DIR=data/generated_contracts
MAX_UPLOAD_SIZE_MB=50

# Analysis Configuration
CLAUSE_EXTRACTION_MODEL=gpt-4-turbo-preview
RIBA_DETECTION_CONFIDENCE_THRESHOLD=0.7
GHARAR_DETECTION_CONFIDENCE_THRESHOLD=0.7

# HITL Tier Classification Thresholds
TIER_1_MAX_VIOLATIONS=0
TIER_2_MAX_CRITICAL_VIOLATIONS=0
TIER_3_THRESHOLD=1  # Any critical violation = Tier 3

# Demo Settings
DEMO_MODE=True
GENERATE_SAMPLE_CONTRACTS=True
SAMPLE_CONTRACT_COUNT=20
# Optional OpenAI-compatible copilot provider
BASE_URL=https://your-copilot-provider.example
API_KEY=replace-with-your-provider-key
MODEL=claude-opus-5
